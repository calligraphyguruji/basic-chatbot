# ==========================================
# BACKEND ENVIRONMENT VARIABLES (server/.env or Vercel Environment)
# ==========================================
# Google Gemini API Key for general conversation and reasoning (server-side only, NEVER expose to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Configured Gemini model (e.g. gemini-2.5-flash, gemini-flash-latest, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Port for local Express backend
PORT=5001

# Allowed client origins for CORS (comma-separated if multiple)
CLIENT_ORIGIN=https://basic-chatbot-kappa.vercel.app

# PostgreSQL Database URL (Supabase, Neon, AWS RDS, Railway, etc.)
# Leave blank to automatically use zero-overhead local storage in development
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_assistant

# JWT / Authentication Secret key for signing session tokens
JWT_SECRET=your_super_secret_jwt_key_here
AUTH_SECRET=your_super_secret_jwt_key_here

# Max message character length (default 4000)
MAX_MESSAGE_LENGTH=4000

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (.env)
# ==========================================
# In local development: leave empty to use Vite's internal reverse proxy (/api -> localhost:5001)
# In split production deployment: set to your deployed backend URL (no trailing slash)
VITE_API_BASE_URL=
