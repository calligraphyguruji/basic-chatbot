# ==========================================
# BACKEND ENVIRONMENT VARIABLES (server/.env)
# Set these on your Backend hosting provider (e.g. Render, Railway)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
PORT=5001
CLIENT_ORIGIN=https://your-frontend.vercel.app

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (.env)
# Set these on your Frontend hosting provider (e.g. Vercel, Netlify)
# ==========================================
# In local development: leave empty to use Vite's internal proxy
# In split production deployment: set to your deployed backend URL (no trailing slash)
VITE_API_BASE_URL=https://your-backend.onrender.com
